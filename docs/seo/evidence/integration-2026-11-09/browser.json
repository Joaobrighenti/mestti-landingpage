            {
              "@type": "FAQPage",
              "@id": "https://mestti.com.br/en/oee/#faq",
              "mainEntity": [
                {
                  "@type": "Question",
                  "name": "What is a good OEE?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "There is no single number. 85% is often cited as a world-class reference, but OEE varies with the type of process. The most useful thing is to compare the same machine over time and find the factor where it loses the most."
                  }
                },
                {
                  "@type": "Question",
                  "name": "What is the difference between OEE and productivity?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Productivity usually looks at how much came out. OEE compares that with what the machine could have made in the planned time and splits the loss into stopped time, pace and quality."
                  }
                },
                {
                  "@type": "Question",
                  "name": "Do micro-stops count in OEE?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Yes. Short stops reduce run time or pace, depending on how the factory classifies them. Without automatic recording, they tend to disappear from manual reports."
                  }
                },
                {
                  "@type": "Question",
                  "name": "Do I need a sensor to measure OEE?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "You can calculate it from manual reports, but stop times and counts become less reliable. With a sensor, the count and stopped time are recorded automatically and the operator only gives the reason."
                  }
                },
                {
                  "@type": "Question",
                  "name": "Can OEE be measured on old machines?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Yes, in most cases. The Mestti sensor reads count pulses or the machine’s electrical signal, with no PLC and no changes to the controls."
                  }
                },
                {
                  "@type": "Question",
                  "name": "Is OEE for the whole factory or for each machine?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Both, but OEE per machine is what shows where to act. The factory average hides the machine that loses the most."
                  }
                }
              ]
            },
