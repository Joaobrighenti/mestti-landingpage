RESEND_API_KEY=
LEADS_TO_EMAIL=joaogbrighenti@gmail.com
# Precisa ser um remetente permitido/validado no Resend (ex.: seu domínio).
FROM_EMAIL=onboarding@resend.dev
PORT=5500

# Google Sheets — leads/chat (scripts/google-sheets-leads.gs)
GOOGLE_SHEETS_WEBHOOK_URL=

# Meta Pixel + Conversions API (somente backend — NUNCA expor o token no frontend)
META_CAPI_ENABLED=true
META_PIXEL_ID=893387710059296
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v26.0
# Preencher só durante testes no Gerenciador de Eventos; vazio em produção
META_CAPI_TEST_EVENT_CODE=
META_SITE_DOMAIN=mestti.com.br
META_CAPI_TIMEOUT_SECONDS=8

# Vercel (Production): Project → Settings → Environment Variables
# Adicione RESEND_API_KEY, LEADS_TO_EMAIL, FROM_EMAIL, GOOGLE_SHEETS_WEBHOOK_URL
# e as variáveis META_* acima (incluindo META_CAPI_ACCESS_TOKEN).
