  "components": [
    {
      "name": "Ação principal",
      "kind": "button",
      "description": "Ação comercial da extensão; amostra sem envio.",
      "html": "<button class=\"ds-primary\" type=\"button\">Solicitar demonstração</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:13px 23px;border:1px solid var(--story-action,#047857);border-radius:6px;background:var(--story-action,#047857);color:#fff;font-size:16px;font-weight:600;text-decoration:none;cursor:pointer;transition:background-color .18s,border-color .18s;font-family:var(--font-family,Inter,sans-serif);}.ds-primary:hover{background:#065f46;border-color:#065f46}.ds-primary:focus-visible{outline:3px solid var(--story-blue,#024578);outline-offset:5px}",
      "refersTo": "button-primary"
    },
    {
      "name": "Ação contornada",
      "kind": "button",
      "description": "Alternativa de exploração com superfície e borda.",
      "html": "<a class=\"ds-outline\" href=\"#produto\">Conhecer o produto</a>",
      "css": ".ds-outline{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:13px 23px;border:1px solid var(--story-action,#047857);border-radius:6px;background:var(--story-action,#047857);color:#fff;font-size:16px;font-weight:600;text-decoration:none;cursor:pointer;transition:background-color .18s,border-color .18s;font-family:var(--font-family,Inter,sans-serif);color:var(--story-blue,#024578);border-color:var(--story-line,#d4e0e8);background:var(--story-paper,#fff)}.ds-outline:hover{border-color:var(--story-blue,#024578);background:var(--story-surface,#f0f5f8)}.ds-outline:focus-visible{outline:3px solid var(--story-blue,#024578);outline-offset:5px}",
      "refersTo": "button-outline"
    },
    {
      "name": "Ação sobre painel azul",
      "kind": "button",
      "description": "Variante branca dentro do painel Otto.",
      "html": "<div class=\"ds-blue\"><button class=\"ds-on-blue\" type=\"button\">Conhecer o Otto</button></div>",
      "css": ".ds-blue{background:#024578;padding:28px;border-radius:12px}.ds-on-blue{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:13px 23px;border:1px solid var(--story-action,#047857);border-radius:6px;background:var(--story-action,#047857);color:#fff;font-size:16px;font-weight:600;text-decoration:none;cursor:pointer;transition:background-color .18s,border-color .18s;font-family:var(--font-family,Inter,sans-serif);background:#fff;color:#024578;border-color:#fff}.ds-on-blue:hover{background:#e3eff6}.ds-on-blue:focus-visible{outline:3px solid #fff;outline-offset:6px}",
      "refersTo": "button-on-blue"
    },
    {
      "name": "Navegação de seção",
      "kind": "nav",
      "description": "Faixa de orientação com links e quebra de linha.",
      "html": "<nav class=\"ds-jump\" aria-label=\"Nesta página\"><a href=\"#producao\">Produção</a><a href=\"#qualidade\">Qualidade</a><a href=\"#engenharia\">Engenharia</a></nav>",
      "css": ".ds-jump{display:flex;flex-wrap:wrap;gap:6px 28px;padding:12px;background:var(--story-surface,#f0f5f8);border-block:1px solid var(--story-line,#d4e0e8);font-family:var(--font-family,Inter,sans-serif);}.ds-jump a{display:inline-flex;align-items:center;min-height:44px;color:var(--story-blue,#024578);font-size:.95rem;font-weight:600;text-underline-offset:4px}.ds-jump a:hover{text-decoration-thickness:2px}.ds-jump a:focus-visible{outline:3px solid var(--story-blue,#024578);outline-offset:5px}"
    },
    {
      "name": "Escolha por necessidade",
      "kind": "card",
      "description": "Linha clicável com divisor, descrição e seta SVG.",
      "html": "<a class=\"ds-choice\" href=\"#producao\"><strong>Produção</strong><span>Ordens, programação e apontamento.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M4 12h15m-6-6 6 6-6 6\"/></svg></a>",
      "css": ".ds-choice{display:grid;grid-template-columns:1fr auto;gap:6px 20px;padding:24px 0;border-top:1px solid var(--story-line,#d4e0e8);text-decoration:none;color:var(--story-blue,#024578);font-family:var(--font-family,Inter,sans-serif);}.ds-choice strong{color:var(--story-ink,#15344a);font-size:1.13rem;line-height:1.45}.ds-choice span{color:var(--story-muted,#496071);font-size:.95rem;line-height:1.6}.ds-choice svg{width:22px;height:22px;align-self:center;grid-column:2;grid-row:1/3;transition:transform .18s}.ds-choice:hover strong{color:var(--story-blue,#024578)}.ds-choice:hover svg{transform:translateX(3px)}.ds-choice:focus-visible{outline:3px solid var(--story-blue,#024578);outline-offset:5px}"
    },
    {
      "name": "Tag de processo",
      "kind": "chip",
      "description": "Rótulo estático do esquema de engenharia; sem estado interativo.",
      "html": "<span class=\"ds-tag\">Processo</span>",
      "css": ".ds-tag{display:inline-block;padding:6px 10px;border:1px solid var(--story-line,#d4e0e8);border-radius:4px;background:var(--story-paper,#fff);color:var(--story-ink,#15344a);font-size:.85rem;font-family:var(--font-family,Inter,sans-serif);}",
      "refersTo": "process-tag"
    },
    {
      "name": "Painel de engenharia",
      "kind": "card",
      "description": "Agrupamento informativo, sem efeito de hover ou ação.",
      "html": "<section class=\"ds-engineering\"><strong>Estrutura do produto</strong><p>Componentes e processos de fabricação.</p></section>",
      "css": ".ds-engineering{padding:28px;border:1px solid var(--story-line,#d4e0e8);border-radius:12px;background:var(--story-surface,#f0f5f8);color:var(--story-ink,#15344a);font-family:var(--font-family,Inter,sans-serif);}.ds-engineering strong{font-size:1.1rem}.ds-engineering p{color:var(--story-muted,#496071);font-size:.9rem;line-height:1.75}",
      "refersTo": "engineering-panel"
    },
    {
      "name": "Checklist editorial",
      "kind": "input",
      "description": "Checkbox nativo da leitura guiada.",
      "html": "<label class=\"ds-check\"><input type=\"checkbox\"><span>Conferir uma ordem real na demonstração</span></label>",
      "css": ".ds-check{display:flex;align-items:flex-start;gap:12px;padding:16px 0;border-bottom:1px solid var(--story-line,#d4e0e8);color:var(--story-ink,#15344a);cursor:pointer;line-height:1.75;font-family:var(--font-family,Inter,sans-serif);}.ds-check input{margin-top:5px;min-width:20px;width:20px;height:20px;accent-color:var(--story-action,#047857)}.ds-check input:checked+span{color:var(--story-muted,#496071)}.ds-check input:focus-visible{outline:3px solid var(--story-blue,#024578);outline-offset:3px}"
    },
    {
      "name": "Campo da conversa de contato",
      "kind": "input",
      "description": "Campo do subsistema conversacional existente; sem integração nesta amostra.",
      "html": "<input class=\"ds-contact-input\" type=\"text\" aria-label=\"Mensagem\" placeholder=\"Sua mensagem\">",
      "css": ".ds-contact-input{min-width:0;min-height:44px;border:0;border-radius:999px;padding:.72rem 1rem;font-size:16px;background:#fff;color:#111;font-family:var(--font-family,Inter,sans-serif);}.ds-contact-input:focus{outline:2px solid rgba(7,94,84,.35);outline-offset:0}"
    },
    {
      "name": "Pergunta frequente",
      "kind": "custom",
      "description": "Disclosure nativo com foco visível; o navegador fornece abrir/fechar.",
      "html": "<details class=\"ds-faq\"><summary>Como conhecer o sistema?</summary><p>Leve um processo real para a demonstração.</p></details>",
      "css": ".ds-faq{border-block:1px solid var(--story-line,#d4e0e8);color:var(--story-ink,#15344a);font-family:var(--font-family,Inter,sans-serif);}.ds-faq summary{padding:22px 36px 22px 0;font-size:1.08rem;font-weight:600;cursor:pointer}.ds-faq summary:focus-visible{outline:3px solid var(--story-blue,#024578);outline-offset:5px}.ds-faq p{padding-bottom:20px;color:var(--story-muted,#496071);margin:0;line-height:1.75}"
    }
  ],
